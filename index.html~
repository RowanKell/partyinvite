<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>You're Invited!</title>
    <style>
        /* Basic Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333;
            background-color:  	#c2e3f8;
	    <!--background-image: url('images/aespa.jpeg');-->
            background-image: linear-gradient(135deg,  	#c2e3f8 0%, #f5e8e0 100%);
            min-height: 100vh;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        
        header {
            text-align: center;
            margin-bottom: 40px;
            animation: fadeIn 1s ease-in;
        }
        
        h1 {
            font-size: 2.5rem;
            color: #5d519c;
            margin-bottom: 10px;
        }
        p1 {
          color : #744a94;
          font-weight: bold;
        }

        .subtitle {
            font-size: 1.2rem;
            font-style: italic;
            color: #666;
        }
        
        .card {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 200px;
            transition: transform 0.3s ease;
	    position: relative;
	    z-index: 1;
	    opacity: 0.9;
        }
        
        .card:hover {
            transform: translateY(-5px);
        }
        
        .event-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .detail-item {
            text-align: center;
            padding: 15px;
        }
        
        .detail-item i {
            font-size: 24px;
            color: #d2691e;
            margin-bottom: 10px;
        }
        
        .detail-label {
            font-weight: bold;
            display: block;
            font-size: 22px;
            margin-bottom: 5px;
        }
        
        .rsvp-form {
            margin-top: 30px;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        
        input, select, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
        }
        
        textarea {
            height: 100px;
            resize: vertical;
        }
        
        .radio-group {
            display: flex;
            gap: 20px;
        }
        
        .radio-option {
            display: flex;
            align-items: center;
        }
        
        .radio-option input {
            width: auto;
            margin-right: 8px;
        }
        
        button {
            background-color: #744a94;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        
        button:hover {
            background-color: #b35a1f;
        }
        
        .response-message {
            margin-top: 20px;
            padding: 15px;
            border-radius: 5px;
            display: none;
        }
        
        .success {
            background-color: #d4edda;
            color: #155724;
        }
        
        .error {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .responses-display {
            margin-top: 280px;
	    margin-bottom: 50px;
	    
        }
        
        .response-item {
            padding: 10px;
            border-bottom: 1px solid #eee;
        }
        
        footer {
            text-align: center;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            color: #777;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Responsive adjustments */
        @media (max-width: 600px) {
            h1 {
                font-size: 2rem;
            }
            
            .event-details {
                grid-template-columns: 1fr;
            }
            
            .radio-group {
                flex-direction: column;
                gap: 10px;
            }
        }
        .background-images {
	    position: absolute;
	    top: 0;
	    left: 50%;
	    width: 1000px;
	    max-width: 100%;
	    transform: translateX(-50%);
	    pointer-events: none; /* allows clicks to pass through */
	    z-index: 0;
	}

	.bg-img {
	    position: absolute;
	    width: 250px;
	    opacity: 0.75;
	    border-radius: 10px;
	    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
	    transform: rotate(-4deg);
	}

	.img1 {
	    top: 50px;
	    left: -15px;
	    transform: rotate(-8deg);
	}

	.img2 {
	    top: 1400px;
	    left: 80px;
	    transform: rotate(-20deg);
	}

	.img3 {
	    top: 590px;
	    left: 700px;
	    transform: rotate(15deg);
	}
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>You're Invited!</h1>
            <p class="subtitle">Wow everyone should really appreciate this website I made.</p>
        </header>

        <section class="card">
            <h2>Event Details</h2>
            <div class="event-details">
                <div class="detail-item">
                    <span class="detail-label">Event</span>
                    <p1>Bake-off 😀</p1>
                    <p>Teams will compete to bake the best cookie/brownie/whatever</p>
                </div>
                    <div class="detail-item">
                    <span class="detail-label">Date</span>
                    <p>Wednesday, May 7th, 2025</p>
                    <p>8:30 PM(ish) - 10:30 PM(ish)</p>

                </div>
                <div class="detail-item">
                    <span class="detail-label">Location</span>
                    <p>Hollows A 2nd floor kitchen<br> (and maybe also my suite A2014)</p>
                </div>
            </div>
            
            <p><b>If you have any baking supplies you can bring, PLEASE BRING! </b>I only turn 22 once, so pull up. Either come in teams or we can make teams when ppl are here, and then we will bake, and everyone can vote after. </p>
        </section>
        
        <section class="card">
            <h2>RSVP</h2>
            <div class="rsvp-form">
                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" required>
                </div>
                
                <div class="form-group">
                    <label for="phone_number">Phone #</label>
                    <input type="phone_number" id="phone_number" name="phone_number" required>
                </div>
                
                <div class="form-group">
                    <label>Will you be attending?</label>
                    <div class="radio-group">
                        <div class="radio-option">
                            <input type="radio" id="attending-yes" name="attending" value="yes" required>
                            <label for="attending-yes">Yes, I'll be there!</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="attending-no" name="attending" value="no">
                            <label for="attending-no">Sorry, I can't make it</label>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="guests">Number of Additional Guests</label>
                    <select id="guests" name="guests">
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3+">3</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message"></textarea>
                </div>
                
                <button type="button" onclick="submitRSVP()">Submit RSVP</button>
                
                <div class="response-message" id="responseMessage"></div>
            </div>
        </section>
        
        <section class="card responses-display" id="responsesSection">
            <h2>Who's Coming</h2>
            <div id="responsesList"></div>
        </section>
        
        <footer>
            <p>For any questions, please contact Rowan: rowan.kelleher@gmail.com</p>
        </footer>
        <div class="background-images">
	  <img src="images/aespa.jpeg" class="bg-img img1" alt="Postcard 1">
	  <img src="images/caelis.jpeg" class="bg-img img2" alt="Postcard 2">
	  <img src="images/physics.jpeg" class="bg-img img3" alt="Postcard 3">
	</div>
    </div>

    <script>
        // Function to submit RSVP via fetch to our Python server
        function submitRSVP() {
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const attending = document.querySelector('input[name="attending"]:checked')?.value;
            const guests = document.getElementById('guests').value;
            const message = document.getElementById('message').value.trim();
            const responseMessage = document.getElementById('responseMessage');
            
            // Validate form
            if (!name || !email || !attending) {
                responseMessage.textContent = 'Please fill out all required fields.';
                responseMessage.className = 'response-message error';
                responseMessage.style.display = 'block';
                return;
            }
            
            // Create RSVP object
            const rsvp = {
                name,
                email,
                attending,
                guests,
                message,
                timestamp: new Date().toISOString()
            };
            
            // Send RSVP to server
            fetch('/submit_rsvp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(rsvp)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                // Update UI
                responseMessage.textContent = 'Thank you for your RSVP!';
                responseMessage.className = 'response-message success';
                responseMessage.style.display = 'block';
                
                // Clear form
                document.getElementById('name').value = '';
                document.getElementById('email').value = '';
                document.querySelector('input[name="attending"]:checked').checked = false;
                document.getElementById('guests').value = '0';
                document.getElementById('message').value = '';
                
                // Update responses list
                fetchResponses();
            })
            .catch(error => {
                // Handle error
                responseMessage.textContent = 'There was a problem submitting your RSVP. Please try again.';
                responseMessage.className = 'response-message error';
                responseMessage.style.display = 'block';
                console.error('Error:', error);
            });
        }
        
        // Function to fetch responses from server
        function fetchResponses() {
            fetch('/get_responses')
            .then(response => response.json())
            .then(data => {
                const responsesList = document.getElementById('responsesList');
                const responsesSection = document.getElementById('responsesSection');
                
                // Only show attending responses
                const attendingRsvps = data.filter(rsvp => rsvp.attending === 'yes');
                
                if (attendingRsvps.length > 0) {
                    responsesList.innerHTML = '';
                    
                    attendingRsvps.forEach(rsvp => {
                        const responseItem = document.createElement('div');
                        responseItem.className = 'response-item';
                        
                        const guestText = rsvp.guests > 0 
                            ? ` plus ${rsvp.guests} additional guest${rsvp.guests > 1 ? 's' : ''}`
                            : '';
                        
                        responseItem.textContent = `${rsvp.name}${guestText}`;
                        responsesList.appendChild(responseItem);
                    });
                } else {
                    responsesList.innerHTML = '<p>No responses yet.</p>';
                }
            })
            .catch(error => {
                console.error('Error fetching responses:', error);
                document.getElementById('responsesList').innerHTML = '<p>Could not load responses.</p>';
            });
        }
        
        // Initialize
        window.onload = function() {
            fetchResponses();
        };
    </script>
</body>
</html>
